# Security & Core
SECRET_KEY=change-me-to-a-very-long-random-string-in-production
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1,example.com
CSRF_TRUSTED_ORIGINS=https://example.com

# Database (PostgreSQL for Docker)
POSTGRES_DB=drone_exams
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_postgres_password
DATABASE_URL=postgres://postgres:change_this_postgres_password@db:5432/drone_exams

# Localization & Info
TIME_ZONE=UTC
SITE_NAME=Drone Academy Examination System
SUPPORT_EMAIL=training@example.com

# Auto-seed initial demo accounts on container boot (1 = enable, 0 = disable)
AUTO_SEED=1
