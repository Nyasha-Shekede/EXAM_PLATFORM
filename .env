# Security & Core
SECRET_KEY=change-me-to-a-very-long-random-string-in-production
DEBUG=1
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080,http://127.0.0.1:8080,https://*.cloudspaces.litng.ai,https://*.litng.ai,https://*.lightning.ai

# SSL / Proxy (Set to 0 when tunneling over plain HTTP; set to 1 in production behind HTTPS reverse proxy)
SECURE_SSL_REDIRECT=0
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0

# Database (PostgreSQL for Docker)
POSTGRES_DB=drone_exams
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_postgres_password
DATABASE_URL=postgres://postgres:change_this_postgres_password@db:5432/drone_exams

# Localization & Info (Zimbabwe / Central Africa Time UTC+2)
TIME_ZONE=Africa/Harare
SITE_NAME=Africa Drone Kings
SUPPORT_EMAIL=training@africadronekings.com

# Dev Admin Account Configuration (Initial superuser to manage instructors & exams)
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_EMAIL=admin@africadronekings.com
DEV_ADMIN_PASSWORD=ChangeMe-Admin-2026
