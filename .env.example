# ==========================================
# Application & Security Settings
# ==========================================
SECRET_KEY=change-me-to-a-very-long-random-string-in-production
DEBUG=1
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080,http://127.0.0.1:8080

# SSL / Proxy (Set to 0 in local dev/tunnel; set to 1 in production behind HTTPS)
SECURE_SSL_REDIRECT=0
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0

# ==========================================
# Database (PostgreSQL)
# ==========================================
POSTGRES_DB=drone_exams
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_postgres_password
# For Docker Compose:
DATABASE_URL=postgres://postgres:change_this_postgres_password@db:5432/drone_exams
# For Local host run:
# DATABASE_URL=postgres://postgres:change_this_postgres_password@localhost:5432/drone_exams
# For Cloud / Vercel (Neon/Supabase/RDS):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

# ==========================================
# Object Storage (MinIO / AWS S3)
# ==========================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminpassword
AWS_STORAGE_BUCKET_NAME=exam-platform
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadminpassword
# Docker Compose internal URL:
AWS_S3_ENDPOINT_URL=http://minio:9000
# Local development on host machine:
# AWS_S3_ENDPOINT_URL=http://localhost:9000
# Cloud / Production MinIO:
# AWS_S3_ENDPOINT_URL=https://minio.yourdomain.com
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ADDRESSING_STYLE=path

# ==========================================
# Email Service (Resend)
# ==========================================
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Africa Drone Kings <training@africadronekings.com>

# ==========================================
# Site Branding & Info
# ==========================================
TIME_ZONE=Africa/Harare
SITE_NAME=Africa Drone Kings
SUPPORT_EMAIL=training@africadronekings.com
PUBLIC_SIGNUP=1

# ==========================================
# Initial Admin Account (Auto-created on docker start)
# ==========================================
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_EMAIL=admin@africadronekings.com
DEV_ADMIN_PASSWORD=ChangeMe-Admin-2026
