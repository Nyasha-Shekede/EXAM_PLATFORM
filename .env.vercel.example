# ==============================================================================
# Vercel Project Environment Variables (Production & Preview)
# Add these directly in Vercel Dashboard -> Project -> Settings -> Environment Variables
# ==============================================================================

# Core Django Settings (STRICTLY REQUIRED ON VERCEL)
DEBUG=0
SECRET_KEY=generate-a-strong-random-key-here-for-production

# PostgreSQL Database (Cloud Postgres, e.g., Neon / Supabase / AWS RDS / Railway)
# NOTE: Vercel cannot reach localhost or docker containers. Database must be public/cloud-hosted.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

# Object Storage (MinIO or AWS S3 / Cloudflare R2)
# NOTE: If using MinIO with Vercel, MinIO MUST be accessible via a public HTTPS URL on the internet.
AWS_STORAGE_BUCKET_NAME=exam-platform
AWS_ACCESS_KEY_ID=your_minio_or_s3_access_key
AWS_SECRET_ACCESS_KEY=your_minio_or_s3_secret_key
AWS_S3_ENDPOINT_URL=https://minio.yourdomain.com
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ADDRESSING_STYLE=path

# Email Service (Resend)
RESEND_API_KEY=re_your_resend_api_key
DEFAULT_FROM_EMAIL=Africa Drone Kings <training@yourdomain.com>

# Optional Custom Domain / Host Settings
# Note: VERCEL_URL is automatically added by Django settings on Vercel.
# Only specify if using your own custom domain:
# ALLOWED_HOSTS=academy.yourdomain.com
# CSRF_TRUSTED_ORIGINS=https://academy.yourdomain.com

# Site branding & flags
SITE_NAME=Africa Drone Kings
SUPPORT_EMAIL=training@africadronekings.com
PUBLIC_SIGNUP=1
