+.learning-actions { display:flex; flex-wrap:wrap; gap:.7rem; }
+.auth-panel { max-width:700px; margin:2rem auto; }
+.eyebrow { font-size:.75rem; font-weight:800; letter-spacing:.08em; text-transform:uppercase; color:var(--adk-blue); }
+.preline { white-space:pre-wrap; overflow-wrap:anywhere; }
+.lesson-content { line-height:1.8; margin:1.5rem 0; }
+.lesson-list { padding-left:1.5rem; line-height:2.4; }
+.lesson-list li { padding:.2rem .5rem; border-bottom:1px solid var(--line); }
+.lesson-list li span { margin-left:1rem; }
+.field label { display:block; font-weight:700; margin-bottom:.35rem; }
+.field input:not([type=checkbox]), .field textarea, .field select { display:block; width:100%; max-width:100%; box-sizing:border-box; padding:.7rem; border:1.5px solid var(--line-strong); border-radius:7px; background:var(--white); color:var(--ink); font:inherit; }
+.field input[type=checkbox] { width:auto; accent-color:var(--adk-blue); }
+.field small { display:block; margin-top:.35rem; color:var(--muted, #475569); }
+.field-error { color:#a11b31; font-weight:700; }
+:focus-visible { outline:3px solid #005b99; outline-offset:3px; }
+@media (max-width:650px) { .top { flex-wrap:wrap; gap:.4rem; } .app-nav { order:3; width:100%; margin:0; padding:.5rem 0; } }
